# Neon Postgres connection string
# Get this from your Neon project dashboard (Connection Details -> Pooled connection)
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Secret used to sign login session tokens (JWT).
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-string
